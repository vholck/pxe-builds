Subject: [PATCH] net: macb: start autonegotiation when the device is probed

The PHY is reset and configured at the first start of the interface, and
that start then waits for autonegotiation: about 3.5 seconds on a
Raspberry Pi 5, spent while nothing else happens.

Reset and configure the PHY when the device is probed and start
autonegotiation there without waiting for it. The link then comes up
while U-Boot scans USB and counts down the boot delay, and the first
start finds it up. A start that comes before the negotiation has finished
waits for it instead of restarting it. If the early setup fails, the
first start does it again as before and reports the error.
---
diff --git a/drivers/net/macb.c b/drivers/net/macb.c
index 68f32eb5..e1b9a4ba 100644
--- a/drivers/net/macb.c
+++ b/drivers/net/macb.c
@@ -150,6 +150,7 @@ struct macb_device {
 
 	struct gpio_desc phy_reset_gpio;
 	bool phy_reset_done;
+	bool phy_aneg_pending;
 	int phy_reset_ms;
 	struct udevice *udev;
 };
@@ -584,14 +585,17 @@ static void macb_phy_reset(struct macb_device *macb, const char *name)
 		       name, status);
 }
 
-static int macb_phy_find(struct macb_device *macb, const char *name)
+static int macb_phy_find(struct macb_device *macb, const char *name,
+			 bool verbose)
 {
 	int i;
 	u16 phy_id;
 
 	phy_id = macb_mdio_read(macb, macb->phy_addr, MII_PHYSID1);
 	if (phy_id != 0xffff) {
-		printf("%s: PHY present at %d\n", name, macb->phy_addr);
+		if (verbose)
+			printf("%s: PHY present at %d\n", name,
+			       macb->phy_addr);
 		return 0;
 	}
 
@@ -600,13 +604,15 @@ static int macb_phy_find(struct macb_device *macb, const char *name)
 		macb->phy_addr = i;
 		phy_id = macb_mdio_read(macb, macb->phy_addr, MII_PHYSID1);
 		if (phy_id != 0xffff) {
-			printf("%s: PHY present at %d\n", name, i);
+			if (verbose)
+				printf("%s: PHY present at %d\n", name, i);
 			return 0;
 		}
 	}
 
 	/* PHY isn't up to snuff */
-	printf("%s: PHY not found\n", name);
+	if (verbose)
+		printf("%s: PHY not found\n", name);
 
 	return -ENODEV;
 }
@@ -715,11 +721,86 @@ static void gem_init_axi(struct macb_device *bp)
 	gem_writel(bp, AMP, amp);
 }
 
+/* Reset (once), find and configure (once) the PHY. Does not wait for a link. */
+static int macb_phy_setup(struct udevice *dev, const char *name, bool verbose)
+{
+	struct macb_device *macb = dev_get_priv(dev);
+	u16 phy_id;
+	int ret;
+
+	/*
+	 * Deassert PHY reset before scanning MDIO, but only once: a
+	 * reset on every start drops the link and renegotiates.
+	 */
+	if (dm_gpio_is_valid(&macb->phy_reset_gpio) &&
+	    !macb->phy_reset_done) {
+		macb->phy_reset_done = true;
+		dm_gpio_set_value(&macb->phy_reset_gpio, 1);
+		mdelay(macb->phy_reset_ms);
+		dm_gpio_set_value(&macb->phy_reset_gpio, 0);
+		mdelay(15);
+	}
+
+	/* Auto-detect phy_addr */
+	ret = macb_phy_find(macb, name, verbose);
+	if (ret)
+		return ret;
+
+	/* Check if the PHY is up to snuff... */
+	phy_id = macb_mdio_read(macb, macb->phy_addr, MII_PHYSID1);
+	if (phy_id == 0xffff) {
+		if (verbose)
+			printf("%s: No PHY present\n", name);
+		return -ENODEV;
+	}
+
+#ifdef CONFIG_PHYLIB
+	if (!macb->phydev) {
+		macb->phydev = phy_connect(macb->bus, macb->phy_addr, dev,
+					   macb->phy_interface);
+		if (!macb->phydev) {
+			printf("phy_connect failed\n");
+			return -ENODEV;
+		}
+
+		phy_config(macb->phydev);
+	}
+#endif
+
+	return 0;
+}
+
+/*
+ * Set the PHY up when the device is probed and start autonegotiation without
+ * waiting for it, so the link comes up while the rest of the boot goes on
+ * instead of holding up the first start of the interface. A failure is not
+ * an error here: the first start tries again and reports it.
+ */
+static void __maybe_unused macb_phy_start_early(struct udevice *dev)
+{
+	struct macb_device *macb = dev_get_priv(dev);
+
+	if (macb_port_is_fixed_link(macb))
+		return;
+
+	if (macb_phy_setup(dev, dev->name, false))
+		return;
+
+	if (macb_mdio_read(macb, macb->phy_addr, MII_BMSR) & BMSR_LSTATUS)
+		return;
+
+	macb_mdio_write(macb, macb->phy_addr, MII_ADVERTISE,
+			ADVERTISE_CSMA | ADVERTISE_ALL);
+	macb_mdio_write(macb, macb->phy_addr, MII_BMCR,
+			BMCR_ANENABLE | BMCR_ANRESTART);
+	macb->phy_aneg_pending = true;
+}
+
 static int macb_phy_init(struct udevice *dev, const char *name)
 {
 	struct macb_device *macb = dev_get_priv(dev);
 	u32 ncfgr;
-	u16 phy_id, status, adv, lpa;
+	u16 status, adv, lpa;
 	int media, speed, duplex;
 	int ret;
 	int i;
@@ -727,48 +808,28 @@ static int macb_phy_init(struct udevice *dev, const char *name)
 	arch_get_mdio_control(name);
 	/* If port is not fixed -> setup PHY */
 	if (!macb_port_is_fixed_link(macb)) {
-		/*
-		 * Deassert PHY reset before scanning MDIO, but only once: a
-		 * reset on every start drops the link and renegotiates.
-		 */
-		if (dm_gpio_is_valid(&macb->phy_reset_gpio) &&
-		    !macb->phy_reset_done) {
-			macb->phy_reset_done = true;
-			dm_gpio_set_value(&macb->phy_reset_gpio, 1);
-			mdelay(macb->phy_reset_ms);
-			dm_gpio_set_value(&macb->phy_reset_gpio, 0);
-			mdelay(15);
-		}
-
-		/* Auto-detect phy_addr */
-		ret = macb_phy_find(macb, name);
+		ret = macb_phy_setup(dev, name, true);
 		if (ret)
 			return ret;
 
-		/* Check if the PHY is up to snuff... */
-		phy_id = macb_mdio_read(macb, macb->phy_addr, MII_PHYSID1);
-		if (phy_id == 0xffff) {
-			printf("%s: No PHY present\n", name);
-			return -ENODEV;
-		}
-
-#ifdef CONFIG_PHYLIB
-		if (!macb->phydev) {
-			macb->phydev = phy_connect(macb->bus, macb->phy_addr, dev,
-						   macb->phy_interface);
-			if (!macb->phydev) {
-				printf("phy_connect failed\n");
-				return -ENODEV;
-			}
-
-			phy_config(macb->phydev);
-		}
-#endif
-
 		status = macb_mdio_read(macb, macb->phy_addr, MII_BMSR);
+		/*
+		 * The link bit latches a lost link until it is read: after
+		 * the negotiation started at probe time, read it again.
+		 */
+		if (macb->phy_aneg_pending && !(status & BMSR_LSTATUS))
+			status = macb_mdio_read(macb, macb->phy_addr, MII_BMSR);
 		if (!(status & BMSR_LSTATUS)) {
-			/* Try to re-negotiate if we don't have link already. */
-			macb_phy_reset(macb, name);
+			/*
+			 * Try to re-negotiate if we don't have link already.
+			 * A negotiation started at probe time is left to
+			 * finish: restarting it would only lose time.
+			 */
+			if (macb->phy_aneg_pending)
+				printf("%s: Waiting for autonegotiation...\n",
+				       name);
+			else
+				macb_phy_reset(macb, name);
 
 			for (i = 0; i < MACB_AUTONEG_TIMEOUT / 100; i++) {
 				status = macb_mdio_read(macb, macb->phy_addr, MII_BMSR);
@@ -784,6 +845,8 @@ static int macb_phy_init(struct udevice *dev, const char *name)
 			}
 		}
 
+		macb->phy_aneg_pending = false;
+
 		if (!(status & BMSR_LSTATUS)) {
 			printf("%s: link down (status: 0x%04x)\n",
 			       name, status);
@@ -1405,6 +1468,8 @@ static int macb_eth_probe(struct udevice *dev)
 	if (ret < 0)
 		return ret;
 	macb->bus = miiphy_get_dev_by_name(dev->name);
+
+	macb_phy_start_early(dev);
 #endif
 
 	return 0;
