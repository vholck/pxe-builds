# Packages finished UEFI builds into the small rpi-uefi stage
# image. Built in CI by .github/workflows/build-rpi-uefi.yml;
# the build context must contain uefi/rpi3/, uefi/rpi4/ and uefi/rpi5/ (the
# generic-<model>/ trees written by build.sh).
FROM alpine:3.24

COPY uefi/ /assets/uefi/
COPY stage.sh /stage.sh

ENTRYPOINT ["/bin/sh", "/stage.sh"]
