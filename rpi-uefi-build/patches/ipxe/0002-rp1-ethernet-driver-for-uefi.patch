@@ -78,12 +78,25 @@ FILE_LICENCE ( GPL2_OR_LATER_OR_UBDL );
 /** Link state check interval */
 #define CGEM_LINK_INTERVAL ( 2 * TICKS_PER_SEC )
 
+/** User I/O register */
+#define CGEM_USRIO 0x0c0
+
 /** Local MAC address (low half) register */
 #define CGEM_LADDRL 0x088
 
 /** Local MAC address (high half) register */
 #define CGEM_LADDRH 0x08c
 
+/** Design configuration register 6 */
+#define CGEM_DCFG6 0x294
+#define CGEM_DCFG6_QUEUES( x )	( (x) & 0xfe )	/**< Priority queue mask */
+
+/** Maximum number of queues */
+#define CGEM_MAX_QUEUES 8
+
+/** TX queue base address register for priority queue n (n >= 1) */
+#define CGEM_TXQBASE_N( n ) ( 0x440 + ( ( (n) - 1 ) * 4 ) )
+
 /** A Cadence GEM descriptor */
 struct cgem_descriptor {
 	/** Buffer address */
@@ -157,7 +170,8 @@ cgem_init_ring ( struct cgem_ring *ring, unsigned int count,
 
 	ring->qbase = qbase;
 	ring->count = count;
-	ring->len = ( count * sizeof ( ring->desc[0] ) );
+	/* One spare descriptor follows the ring */
+	ring->len = ( ( count + 1 ) * sizeof ( ring->desc[0] ) );
 }
 
 /** A Cadence GEM network card */
@@ -170,6 +184,10 @@ struct cgem_nic {
 	struct net_device *netdev;
 	/** Device name (for debugging) */
 	const char *name;
+	/** Quirks */
+	unsigned int quirks;
+	/** Priority queues present (bit n for queue n) */
+	unsigned int queues;
 
 	/** PHY interface */
 	struct mii_interface mdio;
@@ -186,4 +204,13 @@ struct cgem_nic {
 	struct io_buffer *rx_iobuf[CGEM_NUM_RX_DESC];
 };
 
+/** Do not reset the PHY */
+#define CGEM_KEEP_PHY 0x0001
+
+extern struct net_device * cgem_alloc ( struct device *dev,
+					struct dma_device *dma, void *regs,
+					unsigned int quirks );
+extern int cgem_register ( struct net_device *netdev );
