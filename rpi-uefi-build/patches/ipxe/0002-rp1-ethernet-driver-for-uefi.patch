diff --git a/src/drivers/net/efi/rp1gem.c b/src/drivers/net/efi/rp1gem.c
new file mode 100644
index 0000000..f8ab64d
--- /dev/null
+++ b/src/drivers/net/efi/rp1gem.c
@@ -0,0 +1,202 @@
+/*
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA
+ * 02110-1301, USA.
+ *
+ * You can also choose to distribute this program under the terms of
+ * the Unmodified Binary Distribution Licence (as given in the file
+ * COPYING.UBDL), provided that you have satisfied its requirements.
+ */
+
+FILE_LICENCE ( GPL2_OR_LATER_OR_UBDL );
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <ipxe/io.h>
+#include <ipxe/netdevice.h>
+#include <ipxe/efi/efi.h>
+#include <ipxe/efi/efi_driver.h>
+#include <ipxe/efi/efi_pci.h>
+#include "../cgem.h"
+
+/** @file
+ *
+ * Raspberry Pi RP1 Ethernet (Cadence GEM) driver for UEFI
+ *
+ * The RP1 is the I/O chip of the Raspberry Pi 5, attached over PCIe.
+ * The EDK2 firmware for the Pi 5 binds the RP1's PCI device itself
+ * and publishes the RP1 bus protocol on that handle.  This driver
+ * attaches to the same handle without disturbing the firmware's
+ * driver: it asks the bus protocol where the peripherals are mapped
+ * and drives the Ethernet controller found there.
+ */
+
+/** RP1 bus protocol GUID (EDK2 RpiSiliconPkg) */
+#define RP1_BUS_PROTOCOL_GUID						\
+	{ 0xf1417a30, 0x5418, 0x4cd5,					\
+	  { 0x8e, 0x65, 0xf9, 0x02, 0x51, 0x21, 0xb5, 0x7f } }
+
+/** RP1 bus protocol */
+typedef struct _RP1_BUS_PROTOCOL RP1_BUS_PROTOCOL;
+struct _RP1_BUS_PROTOCOL {
+	EFI_PHYSICAL_ADDRESS ( EFIAPI * GetPeripheralBase )
+		( RP1_BUS_PROTOCOL *This );
+};
+
+/** Offset of the Ethernet controller within the RP1 peripherals */
+#define RP1_ETH_BASE 0x00100000
+
+/** Length of the Ethernet controller registers */
+#define RP1_ETH_LEN 0x1000
+
+/** An RP1 Ethernet device */
+struct rp1gem {
+	/** PCI device (for DMA) */
+	struct efi_pci_device efipci;
+	/** Generic device */
+	struct device dev;
+	/** Registers */
+	void *regs;
+	/** Network device */
+	struct net_device *netdev;
+};
+
+/** RP1 bus protocol GUID */
+static EFI_GUID rp1_bus_protocol_guid = RP1_BUS_PROTOCOL_GUID;
+
+/**
+ * Check to see if driver supports a device
+ *
+ * @v device		EFI device handle
+ * @ret rc		Return status code
+ */
+static int rp1gem_supported ( EFI_HANDLE device ) {
+
+	return efi_test ( device, &rp1_bus_protocol_guid );
+}
+
+/**
+ * Attach driver to device
+ *
+ * @v efidev		EFI device
+ * @ret rc		Return status code
+ */
+static int rp1gem_start ( struct efi_device *efidev ) {
+	EFI_HANDLE device = efidev->device;
+	RP1_BUS_PROTOCOL *bus;
+	struct rp1gem *rp1;
+	physaddr_t base;
+	int rc;
+
+	/* Allocate and initialise structure */
+	rp1 = zalloc ( sizeof ( *rp1 ) );
+	if ( ! rp1 ) {
+		rc = -ENOMEM;
+		goto err_alloc;
+	}
+	snprintf ( rp1->dev.name, sizeof ( rp1->dev.name ), "rp1gem" );
+	rp1->dev.desc.bus_type = BUS_TYPE_EFI;
+	rp1->dev.parent = &efidev->dev;
+	INIT_LIST_HEAD ( &rp1->dev.children );
+	list_add ( &rp1->dev.siblings, &efidev->dev.children );
+
+	/* Locate peripherals */
+	if ( ( rc = efi_open ( device, &rp1_bus_protocol_guid,
+			       &bus ) ) != 0 ) {
+		DBGC ( device, "RP1GEM %s has no RP1 bus protocol: %s\n",
+		       efi_handle_name ( device ), strerror ( rc ) );
+		goto err_bus;
+	}
+	base = bus->GetPeripheralBase ( bus );
+	DBGC ( device, "RP1GEM %s peripherals at %#08lx\n",
+	       efi_handle_name ( device ), ( ( unsigned long ) base ) );
+
+	/* Get PCI device, used for DMA only.  The firmware's RP1 bus
+	 * driver keeps the device open and enabled.
+	 */
+	if ( ( rc = efipci_info ( device, &rp1->efipci ) ) != 0 ) {
+		DBGC ( device, "RP1GEM %s is not a PCI device: %s\n",
+		       efi_handle_name ( device ), strerror ( rc ) );
+		goto err_pci;
+	}
+
+	/* Map registers */
+	rp1->regs = ioremap ( ( base + RP1_ETH_BASE ), RP1_ETH_LEN );
+	if ( ! rp1->regs ) {
+		rc = -ENODEV;
+		goto err_ioremap;
+	}
+
+	/* Allocate and register network device.  The PHY keeps the
+	 * setup done by the Raspberry Pi bootloader.
+	 */
+	rp1->netdev = cgem_alloc ( &rp1->dev, &rp1->efipci.pci.dma, rp1->regs,
+				   CGEM_KEEP_PHY );
+	if ( ! rp1->netdev ) {
+		rc = -ENOMEM;
+		goto err_netdev;
+	}
+	if ( ( rc = cgem_register ( rp1->netdev ) ) != 0 ) {
+		DBGC ( device, "RP1GEM %s could not register: %s\n",
+		       efi_handle_name ( device ), strerror ( rc ) );
+		goto err_register;
+	}
+
+	efidev_set_drvdata ( efidev, rp1 );
+	return 0;
+
+	cgem_unregister ( rp1->netdev );
+ err_register:
+	netdev_nullify ( rp1->netdev );
+	netdev_put ( rp1->netdev );
+ err_netdev:
+	iounmap ( rp1->regs );
+ err_ioremap:
+ err_pci:
+ err_bus:
+	list_del ( &rp1->dev.siblings );
+	free ( rp1 );
+ err_alloc:
+	return rc;
+}
+
+/**
+ * Detach driver from device
+ *
+ * @v efidev		EFI device
+ */
+static void rp1gem_stop ( struct efi_device *efidev ) {
+	struct rp1gem *rp1 = efidev_get_drvdata ( efidev );
+
+	cgem_unregister ( rp1->netdev );
+	netdev_nullify ( rp1->netdev );
+	netdev_put ( rp1->netdev );
+	iounmap ( rp1->regs );
+	list_del ( &rp1->dev.siblings );
+	free ( rp1 );
+}
+
+/** RP1 Ethernet driver */
+struct efi_driver rp1gem_driver __efi_driver ( EFI_DRIVER_HARDWARE ) = {
+	.name = "RP1GEM",
+	.supported = rp1gem_supported,
+	.start = rp1gem_start,
+	.stop = rp1gem_stop,
+};
+
+/* Generate build rules */
+EFI_ROM ( "rp1gem", "Raspberry Pi RP1 Ethernet" );
