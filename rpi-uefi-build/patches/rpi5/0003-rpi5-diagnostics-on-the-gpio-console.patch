diff --git a/Platform/RaspberryPi/RPi5/Library/Rpi5SerialPortLib/Rpi5SerialPortLib.c b/Platform/RaspberryPi/RPi5/Library/Rpi5SerialPortLib/Rpi5SerialPortLib.c
new file mode 100644
index 0000000..035d278
--- /dev/null
+++ b/Platform/RaspberryPi/RPi5/Library/Rpi5SerialPortLib/Rpi5SerialPortLib.c
@@ -0,0 +1,255 @@
+/** @file
+  Serial port library of the Raspberry Pi 5: the debug UART (a PL011 on the
+  3-pin connector), as PL011SerialPortLib, and in addition a copy of
+  everything written for the serial port on GPIO 14 and 15.
+
+  That port belongs to the RP1 chip and appears late in the boot. Output is
+  recorded in memory until Rp1UartDxe has set the port up, and written to it
+  directly afterwards. See Rpi5EarlyLog.h.
+
+  Based on ArmPlatformPkg/Library/PL011SerialPortLib.
+
+  Copyright (c) 2008 - 2010, Apple Inc. All rights reserved.<BR>
+  Copyright (c) 2012 - 2016, ARM Ltd. All rights reserved.<BR>
+  Copyright (c) 2015, Intel Corporation. All rights reserved.<BR>
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Base.h>
+
+#include <Library/BaseMemoryLib.h>
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/PL011UartClockLib.h>
+#include <Library/PL011UartLib.h>
+#include <Library/SerialPortLib.h>
+#include <Rpi5EarlyLog.h>
+
+#define DEBUG_UART_BASE  ((UINTN)PcdGet64 (PcdSerialRegisterBase))
+
+#ifdef RPI5_EARLY_LOG_OWNER
+//
+// Only in the instance linked into the first module of a boot (SEC). The
+// firmware image is loaded into RAM, so the variable can be written.
+//
+STATIC BOOLEAN  mEarlyLogStarted = FALSE;
+#endif
+
+/**
+  Record the output, or write it to the GPIO serial port when that is up.
+**/
+STATIC
+VOID
+EarlyLogWrite (
+  IN UINT8  *Buffer,
+  IN UINTN  NumberOfBytes
+  )
+{
+  RPI5_EARLY_LOG  *Log;
+  UINTN           Room;
+
+  Log = (RPI5_EARLY_LOG *)(UINTN)RPI5_EARLY_LOG_BASE;
+  if (Log->Magic != RPI5_EARLY_LOG_MAGIC) {
+    return;
+  }
+
+  if (Log->GpioUartBase != 0) {
+    PL011UartWrite ((UINTN)Log->GpioUartBase, Buffer, NumberOfBytes);
+    return;
+  }
+
+  if (Log->Used > RPI5_EARLY_LOG_CAPACITY) {
+    return;
+  }
+
+  Room = RPI5_EARLY_LOG_CAPACITY - Log->Used;
+  if (NumberOfBytes > Room) {
+    Log->Dropped += (UINT32)(NumberOfBytes - Room);
+    NumberOfBytes = Room;
+  }
+
+  CopyMem (Log->Data + Log->Used, Buffer, NumberOfBytes);
+  Log->Used += (UINT32)NumberOfBytes;
+}
+
+/**
+  Initialise the debug UART.
+
+  @retval RETURN_SUCCESS            The serial device was initialised.
+  @retval RETURN_INVALID_PARAMETER  One or more of the default settings
+                                    has an unsupported value.
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortInitialize (
+  VOID
+  )
+{
+  UINT64              BaudRate;
+  UINT32              ReceiveFifoDepth;
+  EFI_PARITY_TYPE     Parity;
+  UINT8               DataBits;
+  EFI_STOP_BITS_TYPE  StopBits;
+  RETURN_STATUS       Status;
+  UINT8               Scratch;
+
+ #ifdef RPI5_EARLY_LOG_OWNER
+  RPI5_EARLY_LOG  *Log;
+
+  //
+  // A new boot: start an empty record. RAM keeps its content over a reset,
+  // so whatever is there, a port address above all, is stale.
+  //
+  if (!mEarlyLogStarted) {
+    Log               = (RPI5_EARLY_LOG *)(UINTN)RPI5_EARLY_LOG_BASE;
+    Log->GpioUartBase = 0;
+    Log->Used         = 0;
+    Log->Dropped      = 0;
+    Log->Reserved     = 0;
+    Log->Magic        = RPI5_EARLY_LOG_MAGIC;
+    mEarlyLogStarted  = TRUE;
+  }
+
+ #endif
+
+  BaudRate         = PcdGet64 (PcdUartDefaultBaudRate);
+  ReceiveFifoDepth = 0;         // Use default FIFO depth
+  Parity           = (EFI_PARITY_TYPE)PcdGet8 (PcdUartDefaultParity);
+  DataBits         = PcdGet8 (PcdUartDefaultDataBits);
+  StopBits         = (EFI_STOP_BITS_TYPE)PcdGet8 (PcdUartDefaultStopBits);
+
+  Status = PL011UartInitializePort (
+             DEBUG_UART_BASE,
+             PL011UartClockGetFreq (),
+             &BaudRate,
+             &ReceiveFifoDepth,
+             &Parity,
+             &DataBits,
+             &StopBits
+             );
+  if (RETURN_ERROR (Status)) {
+    return Status;
+  }
+
+  if (PcdGetBool (PcdSerialUseHardwareFlowControl)) {
+    Status = PL011UartSetControl (
+               DEBUG_UART_BASE,
+               EFI_SERIAL_HARDWARE_FLOW_CONTROL_ENABLE
+               );
+    if (RETURN_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  //
+  // Empty the receive buffer.
+  //
+  while (SerialPortPoll ()) {
+    SerialPortRead (&Scratch, sizeof (Scratch));
+  }
+
+  return RETURN_SUCCESS;
+}
+
+/**
+  Write data to the debug UART, and to the record or the GPIO serial port.
+
+  @param  Buffer         The data to write.
+  @param  NumberOfBytes  The number of bytes in Buffer.
+
+  @return The number of bytes written to the debug UART.
+**/
+UINTN
+EFIAPI
+SerialPortWrite (
+  IN UINT8  *Buffer,
+  IN UINTN  NumberOfBytes
+  )
+{
+  EarlyLogWrite (Buffer, NumberOfBytes);
+
+  return PL011UartWrite (DEBUG_UART_BASE, Buffer, NumberOfBytes);
+}
+
+/**
+  Read data from the debug UART.
+
+  @param  Buffer         Where to store the data.
+  @param  NumberOfBytes  The number of bytes to read.
+
+  @return The number of bytes read.
+**/
+UINTN
+EFIAPI
+SerialPortRead (
+  OUT UINT8  *Buffer,
+  IN  UINTN  NumberOfBytes
+  )
+{
+  return PL011UartRead (DEBUG_UART_BASE, Buffer, NumberOfBytes);
+}
+
+/**
+  Check whether the debug UART has received data.
+
+  @retval TRUE   At least one byte can be read.
+  @retval FALSE  No data.
+**/
+BOOLEAN
+EFIAPI
+SerialPortPoll (
+  VOID
+  )
+{
+  return PL011UartPoll (DEBUG_UART_BASE);
+}
+
+/**
+  Set the line settings of the debug UART. See PL011UartInitializePort().
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortSetAttributes (
+  IN OUT UINT64              *BaudRate,
+  IN OUT UINT32              *ReceiveFifoDepth,
+  IN OUT UINT32              *Timeout,
+  IN OUT EFI_PARITY_TYPE     *Parity,
+  IN OUT UINT8               *DataBits,
+  IN OUT EFI_STOP_BITS_TYPE  *StopBits
+  )
+{
+  return PL011UartInitializePort (
+           DEBUG_UART_BASE,
+           PL011UartClockGetFreq (),
+           BaudRate,
+           ReceiveFifoDepth,
+           Parity,
+           DataBits,
+           StopBits
+           );
+}
+
+/**
+  Set the control signals of the debug UART. See PL011UartSetControl().
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortSetControl (
+  IN UINT32  Control
+  )
+{
+  return PL011UartSetControl (DEBUG_UART_BASE, Control);
+}
+
+/**
+  Read the control signals of the debug UART. See PL011UartGetControl().
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortGetControl (
+  OUT UINT32  *Control
+  )
+{
+  return PL011UartGetControl (DEBUG_UART_BASE, Control);
+}
