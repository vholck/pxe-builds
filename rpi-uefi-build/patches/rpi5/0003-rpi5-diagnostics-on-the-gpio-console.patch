+/**
+  Print on the new port the diagnostics recorded since the firmware started,
+  then let the serial port library write to the port directly.
+
+  The markers are there because the replayed lines are not printed when they
+  happened: in a timed capture they all carry the time of the replay.
+**/
+STATIC
+VOID
+ReplayEarlyLog (
+  VOID
+  )
+{
+  RPI5_EARLY_LOG  *Log;
+  CHAR8           Line[120];
+  UINTN           Used;
+
+  Log = (RPI5_EARLY_LOG *)(UINTN)RPI5_EARLY_LOG_BASE;
+  if (Log->Magic != RPI5_EARLY_LOG_MAGIC) {
+    return;
+  }
+
+  Used = MIN (Log->Used, RPI5_EARLY_LOG_CAPACITY);
+  if (Used != 0) {
+    AsciiSPrint (
+      Line,
+      sizeof (Line),
+      "\r\n--- UEFI firmware %s: earlier output, replayed ---\r\n",
+      (CHAR16 *)PcdGetPtr (PcdFirmwareVersionString)
+      );
+    PL011UartWrite (mUartBase, (UINT8 *)Line, AsciiStrLen (Line));
+    PL011UartWrite (mUartBase, (UINT8 *)Log->Data, Used);
+
+    if (Log->Dropped != 0) {
+      AsciiSPrint (
+        Line,
+        sizeof (Line),
+        "\r\n--- end of replay (%u more bytes were not recorded), live from here ---\r\n",
+        Log->Dropped
+        );
+    } else {
+      AsciiSPrint (Line, sizeof (Line), "\r\n--- end of replay, live from here ---\r\n");
+    }
