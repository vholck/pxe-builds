diff --git a/Platform/RaspberryPi/RPi5/Include/Rpi5EarlyLog.h b/Platform/RaspberryPi/RPi5/Include/Rpi5EarlyLog.h
new file mode 100644
index 0000000..5b4c9db
--- /dev/null
+++ b/Platform/RaspberryPi/RPi5/Include/Rpi5EarlyLog.h
@@ -0,0 +1,55 @@
+/** @file
+  Record of the firmware's diagnostic output on a Raspberry Pi 5.
+
+  The serial port on GPIO 14 and 15 belongs to the RP1 chip and cannot be
+  reached before PCIe has been enumerated. Until then the firmware's serial
+  port library (Rpi5SerialPortLib) also writes what it prints into this
+  record. When the port is up, Rp1UartDxe prints the record there and enters
+  the port's address; from then on the library writes to both ports.
+
+  The record lives at a fixed address, the first 64 KiB of system RAM, which
+  the platform's memory map reserves. A fixed address is used because the
+  library is linked into every module separately, the first of them long
+  before there is a HOB list or a protocol database to find shared data in.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef RPI5_EARLY_LOG_H_
+#define RPI5_EARLY_LOG_H_
+
+#include <Base.h>
+
+//
+// Must be equal to PcdSystemMemoryBase; RaspberryPiMem.c checks it.
+//
+#define RPI5_EARLY_LOG_BASE   0x00400000
+#define RPI5_EARLY_LOG_SIZE   0x00010000
+#define RPI5_EARLY_LOG_MAGIC  SIGNATURE_32 ('R', '5', 'L', 'G')
+
+typedef struct {
+  //
+  // RPI5_EARLY_LOG_MAGIC while the record is in use. Set by the first module
+  // of a boot (SEC), cleared at ExitBootServices.
+  //
+  UINT32    Magic;
+  //
+  // Number of bytes in Data.
+  //
+  UINT32    Used;
+  //
+  // Number of bytes that did not fit.
+  //
+  UINT32    Dropped;
+  UINT32    Reserved;
+  //
+  // 0 while the GPIO serial port is not available: output is recorded.
+  // Otherwise the address of its PL011 registers: output is written there.
+  //
+  UINT64    GpioUartBase;
+  CHAR8     Data[];
+} RPI5_EARLY_LOG;
+
+#define RPI5_EARLY_LOG_CAPACITY  (RPI5_EARLY_LOG_SIZE - OFFSET_OF (RPI5_EARLY_LOG, Data))
+
+#endif // RPI5_EARLY_LOG_H_
