diff --git a/plat/rpi/rpi5/rpi5_setup.c b/plat/rpi/rpi5/rpi5_setup.c
index de82300..a1dad51 100644
--- a/plat/rpi/rpi5/rpi5_setup.c
+++ b/plat/rpi/rpi5/rpi5_setup.c
@@ -4,8 +4,97 @@
  * SPDX-License-Identifier: BSD-3-Clause
  */
 
+#include <stddef.h>
+#include <stdint.h>
+
+#include <arch_helpers.h>
+#include <drivers/console.h>
+#include <platform_def.h>
+
 #include <rpi_shared.h>
 
+/*
+ * Record of early console output.
+ *
+ * The serial port on GPIO 14 and 15 of a Raspberry Pi 5 belongs to the RP1
+ * chip, which cannot be reached before the UEFI firmware has enumerated PCIe.
+ * What is printed before that is recorded in memory, and the UEFI firmware
+ * prints the record on that port when it has set it up. This is the same
+ * record the UEFI firmware's serial port library writes to; the layout is
+ * RPI5_EARLY_LOG in Rpi5EarlyLog.h of the Raspberry Pi 5 platform in
+ * edk2-platforms and must match it.
+ *
+ * BL31 runs first, so it starts the record. Only its boot messages are
+ * recorded: the console is not kept for the runtime.
+ *
+ * Every write is flushed from the data cache. The UEFI firmware starts with
+ * the MMU and the caches off and reads and extends the record in RAM; a
+ * header still sitting in the cache would later replace what it wrote there
+ * (seen: its first line was missing from the record).
+ */
+#define EARLY_LOG_MAGIC		U(0x474c3552)	/* "R5LG" */
+#define EARLY_LOG_STARTED_BY_TFA	U(0x31414654)	/* "TFA1" */
+
+struct rpi5_early_log {
+	uint32_t magic;
+	uint32_t used;
+	uint32_t dropped;
+	/*
+	 * EARLY_LOG_STARTED_BY_TFA tells the UEFI firmware that the record
+	 * was started in this boot. It clears the field when it has seen it.
+	 */
+	uint32_t started_by;
+	/* Set by the UEFI firmware when the port is up; nothing is recorded then. */
+	uint64_t gpio_uart_base;
+	char data[];
+};
+
+#define EARLY_LOG_CAPACITY	(RPI_EARLY_LOG_SIZE - \
+				 offsetof(struct rpi5_early_log, data))
+
+static int rpi5_early_log_putc(int c, console_t *console)
+{
+	struct rpi5_early_log *log = (struct rpi5_early_log *)console->base;
+
+	if (log->magic != EARLY_LOG_MAGIC || log->gpio_uart_base != 0U) {
+		return c;
+	}
+
+	if (log->used < EARLY_LOG_CAPACITY) {
+		log->data[log->used] = (char)c;
+		flush_dcache_range((uintptr_t)&log->data[log->used], 1U);
+		log->used++;
+	} else {
+		log->dropped++;
+	}
+
+	flush_dcache_range((uintptr_t)log, sizeof(*log));
+
+	return c;
+}
+
+static console_t rpi5_early_log_console = {
+	.flags = CONSOLE_FLAG_BOOT,
+	.putc = rpi5_early_log_putc,
+	.base = RPI_EARLY_LOG_BASE,
+};
+
+void rpi5_early_log_init(void)
+{
+	struct rpi5_early_log *log =
+		(struct rpi5_early_log *)rpi5_early_log_console.base;
+
+	/* RAM keeps its content over a reset: whatever is there is stale. */
+	log->gpio_uart_base = 0U;
+	log->used = 0U;
+	log->dropped = 0U;
+	log->started_by = EARLY_LOG_STARTED_BY_TFA;
+	log->magic = EARLY_LOG_MAGIC;
+	flush_dcache_range((uintptr_t)log, sizeof(*log));
+
+	(void)console_register(&rpi5_early_log_console);
+}
