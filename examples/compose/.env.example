# Copy to .env and fill in. Documentation addresses (192.0.2.0/24) as placeholders.

# The LAN: router, netmask, the same subnet in CIDR notation, and the host NIC
# the macvlan network attaches to
LAN_GATEWAY=192.0.2.1
LAN_NETMASK=255.255.255.0
LAN_SUBNET=192.0.2.0/24
LAN_PARENT_IF=eth0

# Address of the dnsmasq container: free, outside the router's DHCP pool
PXE_LAN_IP=192.0.2.10

# What a client boots when it has no ipxe/hosts/<mac>.ipxe script
IPXE_CHAIN_URI=tftp://192.0.2.10/ipxe/netbootxyz.ipxe

# Owner of the published files on the host
PUID=1000
PGID=1000

# Host directories (default: next to this file)
#TFTP_DIR=./tftp
#MATCHBOX_DIR=./matchbox
#NFS_DIR=./nfs
#ISCSI_DIR=./iscsi

# Raspberry Pis that boot UEFI instead of U-Boot (serials, space-separated)
RPI5_UEFI_SERIALS=
RPI4_UEFI_SERIALS=
RPI3_UEFI_SERIALS=

# 1 = ipxe/boot.ipxe asks Matchbox; start it with: docker compose --profile matchbox up -d
MATCHBOX_ENABLED=0
# Optional servers: docker compose --profile nfs --profile iscsi up -d
NFS_CLIENTS=
ISCSI_CLIENTS=
