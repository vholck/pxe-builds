# =============================================================================
# Build settings for every image in this repository.
#
# CI reads this file when it builds an image (.github/workflows/build-*.yml);
# a push that changes it rebuilds the images that use the changed settings.
# Local builds read it too: docker compose --env-file ../build.env ...
#
# Only what is compiled or baked into an image belongs here. What the pxe stack
# decides when it runs (addresses, which Pis boot UEFI, per-machine scripts)
# is set in the stack, not here.
# =============================================================================

# --- Every Pi family and firmware ---------------------------------------------

# Operating system console (platform rule R2: the same choice on every Pi and
# under both firmwares). The firmware always describes the serial port to the
# OS (device tree stdout-path, ACPI SPCR); this chooses which console is the
# main one (/dev/console) when the OS is given no console=.
# auto   = the display when one is connected, else serial (upstream behaviour)
# serial = serial, also with a display connected (the display gets output too).
# serial here: the test Pis are driven over the GPIO serial cable.
CONSOLE_MAIN=serial

# Upstream Linux device trees of the Pis (rpi/upstream/broadcom/, and the Pi 5
# board trees under UEFI with UEFI_RPI5_DT=upstream): tag of devicetree-rebasing
# (https://git.kernel.org/pub/scm/linux/kernel/git/devicetree/devicetree-rebasing.git,
# the Linux tree's device tree files, one tag per Linux release) and the commit
# it must point to (the build fails otherwise). Read by rpi-uboot-build and
# rpi-uefi-build, so both firmwares serve the same trees. Bump deliberately and
# boot-test (dts/README.md says what to check).
RPI_DT_TAG=v7.3-dts
RPI_DT_COMMIT=44ab80381f4714c7e073a85fe9796f1cff8801c0

# --- iPXE (ipxe-build) ---------------------------------------------------------

# iPXE commit to build (https://github.com/ipxe/ipxe)
IPXE_REF=b847e5f0734f6130c6ee1a4cacdcff508e7aaa3e
# user-class the iPXE binaries send (dnsmasq matches it) and version banner name
IPXE_PRODUCT_NAME=iPXE-mod
# keyboard layout for iPXE. Under UEFI/U-Boot it also remaps keys typed over
# serial (they arrive like keyboard keys); us leaves serial input untouched.
IPXE_KEYBOARD_MAP=us
# action when DHCP or the chain fails: reboot, or shell for debugging
IPXE_ON_FAILURE=reboot
# 0 = iPXE configures IPv4 only (DHCP). 1 = it also waits for an IPv6 router
# and takes an IPv6 address; without such a router every boot waits about 4 s.
IPXE_IPV6=0
# Which iPXE builds write to the serial port themselves: bios (default), efi, all, off.
# UEFI firmware that redirects its console to serial shows iPXE's output once
# with bios, twice with all. The Pis are the same either way (their UARTs are
# not the 16550 type iPXE drives).
IPXE_SERIAL_CONSOLE=bios
# 1 = iPXE also trusts the netboot.xyz CA (netboot.xyz menu signatures verify;
# that CA is then also trusted for HTTPS). 0 = upstream: iPXE's root CA only.
IPXE_TRUST_NETBOOTXYZ=1
# Highest TLS version iPXE offers: 1.3 (upstream), or 1.2. Before iPXE b847e5f
# TLS 1.3 failed with Flatcar's, Alpine's, Debian's and NixOS's servers.
IPXE_TLS_MAX=1.3
# iPXE debug subsystems to compile in (e.g. x509:3,tls:3); empty to disable
IPXE_DEBUG=
# optional version string suffix
IPXE_BUILD_TAG=
# 1 = also build extra iPXE variants (ipxe.pxe, ipxe.lkrn, full-driver and snp EFI)
BUILD_EXTRA_IPXE_ARTIFACTS=0
# 1 = also build bootable ISO/USB media
BUILD_OPTIONAL_IPXE_MEDIA=0

# --- U-Boot for the Pis (rpi-uboot-build) --------------------------------------

# Commit of https://github.com/raspberrypi/firmware the boot files (start*.elf,
# fixup*.dat, device trees, overlays) are taken from. Pinned; bump deliberately
# and boot-test.
FIRMWARE_VERSION=d131b57900035c0562af1898c00a1bf59d3b9d1e

# Seconds U-Boot waits before its DHCP request. Empty keeps the per-model default
# (5). Measured on a Pi 4: 0 and 5 reach iPXE equally fast, because the wait for
# the network link is the same either way.
UBOOT_PRE_DHCP_SLEEP=

# Local devices U-Boot tries, in this order, when the network boot fails or iPXE
# returns (netboot.xyz's "Boot from local hdd"): any of mmc (SD card), usb and
# nvme (Pi 5 only; left out on the Pi 3 and Pi 4), space-separated, e.g.
# "usb mmc". Empty keeps upstream's order: mmc usb, on the Pi 5 mmc nvme usb.
UBOOT_LOCAL_BOOT_ORDER=

# Device tree the Pi 5's U-Boot hands to iPXE and from there to the kernel it
# starts: firmware (default) = Raspberry Pi's tree, as on every Pi (rule R3);
# an OS that needs the upstream Linux tree loads it itself (fcos.ipxe and the
# CoreOS boot scripts do, by the FdtFile variable). upstream = the upstream
# Linux tree (rpi/upstream/) for every OS, for scripts that cannot ask (Ethernet
# and USB behind RP1 for distribution kernels).
UBOOT_RPI5_EFI_FDT=firmware

# EFI binary path baked into U-Boot bootcmd, relative to the TFTP root. Must match
# the path the ipxe-build image publishes.
EFI_ARM64_RPI_FILE=ipxe/snponly-arm64-rpi.efi

# --- UEFI for the Pis (rpi-uefi-build) -----------------------------------------

# Commit of https://github.com/pftf/RPi4 to build. It fixes the EDK2 submodule
# commits and is used for both Pi 3 and Pi 4. Bump deliberately and boot-test.
PFTF_REF=3db317e8428bc43211ba5dbc0cad01143a565ef7
# Commit of https://github.com/NumberOneGit/rpi5-uefi to build for the Pi 5 (the
# maintained fork of the archived worproject/rpi5-uefi). It fixes the commits of
# its own EDK2 and Trusted Firmware-A submodules. Bump deliberately and boot-test.
RPI5_UEFI_REF=ad501cf3aeb7060b1ce0324b9d8972a4daf19b38
# Trusted Firmware-A (BL31, first stage of the Pi 5 image) from
# https://github.com/ARM-software/arm-trusted-firmware, pinned apart from the
# port: its submodule (000fe22, 2025-07-11) lacks the CVE-2025-10263
# workaround for the Pi 5. The build fails unless the tag is the commit given.
# Empty RPI5_TFA_TAG = the port's own submodule. Bump deliberately, check
# rpi-uefi-build/patches/rpi5-tfa, and boot-test.
RPI5_TFA_TAG=lts-v2.14.15
RPI5_TFA_COMMIT=28b7463297f5563318b3656f0a003e82183510a2
# Commits of https://github.com/raspberrypi/firmware the boot files come from
START_ELF_VERSION=d131b57900035c0562af1898c00a1bf59d3b9d1e
DTB_VERSION=d131b57900035c0562af1898c00a1bf59d3b9d1e
DTBO_VERSION=d131b57900035c0562af1898c00a1bf59d3b9d1e
# Commit of https://github.com/ipxe/ipxe built as the UEFI driver for the Pi 3's
# onboard USB Ethernet and embedded in the Pi 3 firmware (not used for the Pi 4)
UEFI_IPXE_REF=b847e5f0734f6130c6ee1a4cacdcff508e7aaa3e

# warn    = errors and warnings on the serial console; asserts do not halt the
#           boot. Boots as fast as release (measured on a Pi 4).
# release = no diagnostic output
# debug   = full EDK2 debug output; slow, and a failed assert halts the boot
UEFI_BUILD_TYPE=warn

# Firmware setting defaults. Settings changed in the firmware menu may not
# survive a reboot when the firmware is loaded over TFTP, so set what you need here.
# seconds the "ESC (setup), F1 (shell), ENTER (boot)" prompt is shown
UEFI_BOOT_TIMEOUT=2
# Every Pi: hardware description handed to the OS: acpi | both | devicetree |
# upstream (upstream keeps each model's default: Pi 3 both, Pi 4 and Pi 5 acpi).
# both = ACPI and the Pi firmware's device tree: arm64 Linux uses the tree,
# which Raspberry Pi kernels need (they panic with ACPI only).
UEFI_SYSTEM_TABLE=both
# Pi 5 B device tree loaded by the Pi firmware and handed to the OS: firmware
# (default) = Raspberry Pi's tree, as on every Pi (rule R3); an OS that needs
# the upstream Linux tree loads it itself by the FdtFile variable. upstream =
# the upstream Linux tree with the RP1's GPIO UART (dts/) for every OS.
# CM5 and Pi 500 always get Raspberry Pi's tree.
UEFI_RPI5_DT=firmware
# Pi 4 only: 1 limits RAM to 3 GB (the upstream default), 0 uses all RAM
UEFI_RAM_LIMIT_3GB=0
# 0 = IPv4 only: no PXE over IPv6 and no HTTP boot over IPv6, so nothing waits
# for them (about 2 minutes without an IPv6 router, e.g. after iPXE hands back).
# 1 = the IPv6 network stack and both boot options, as upstream.
UEFI_IPV6=0
# HDMI mode as <group>:<mode> (config.txt hdmi_group / hdmi_mode), e.g. 1:4 = 720p60,
# 1:16 = 1080p60. Empty = the Pi chooses (640x480 when it cannot detect the display).
UEFI_HDMI_MODE=
